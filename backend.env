# --- Bí mật ------------------------------------------------------------------
# ENCRYPTION_KEY: prod đang chạy DEFAULT DEV ("dev-encryption-key-change-in-production")
# vì compose cũ không set. Sinh key mới (openssl rand -hex 32) — NHƯNG nhớ:
# provider nào đã lưu trong DB prod trước đó được mã hoá bằng key cũ, đổi key
# xong phải nhập lại config provider (/admin/providers) hoặc chạy lại seed.
# BACKUP key này riêng — mất key = mất toàn bộ credential provider.
ENCRYPTION_KEY=357d071e59ef27470cca04b92cc1326523c06ec8eb39571057ecb3c12ef0359b

# --- URL công khai -----------------------------------------------------------
# PayOS redirect khách về FRONTEND sau thanh toán; BACKEND in vào delivered_data
# gateway (/gw/{key}/...) và callback_url cho seller webhook.
#FRONTEND_BASE_URL=https://market.taskforces.info
#BACKEND_BASE_URL=https://api-market.taskforces.info

FRONTEND_BASE_URL=lab-market.taskforces.info
BACKEND_BASE_URL=lab-api-market.taskforces.info

#Sign Request
