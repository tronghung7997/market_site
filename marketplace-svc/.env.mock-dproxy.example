# Copy to .env.mock-dproxy (gitignored) and replace every secret before exposing
# the service through Cloudflare Tunnel.
#
# Port and cooldown here MUST match docs/dproxy-mock-runbook.md and
# scripts/seed_demo.py's DProxy section — 9201/15s is the one demo config
# used everywhere so a fresh clone doesn't have to reconcile mismatched
# instructions. 15s (not a token 2s) is deliberate: long enough that a
# manual tester actually sees the "Đổi IP (Ns)" countdown/429 instead of it
# clearing between two clicks.
MOCK_DPROXY_PORT=9201
# Local dev with no .env.mock-dproxy sourced at all defaults to this same
# value on both the mock server AND scripts/seed_demo.py, so the two work
# together out of the box. Replace before exposing via Cloudflare Tunnel.
MOCK_DPROXY_API_KEY=replace-with-a-long-random-api-key
MOCK_DPROXY_CONTROL_KEY=replace-with-a-different-long-random-control-key
MOCK_DPROXY_DASHBOARD_USER=admin
MOCK_DPROXY_DASHBOARD_PASSWORD=replace-with-a-long-random-dashboard-password
MOCK_DPROXY_AUTH_TYPE=bearer
MOCK_DPROXY_COOLDOWN_SECONDS=15
