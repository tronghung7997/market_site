NEXT_PUBLIC_API_URL=/api
API_URL=http://localhost:8001
TIKTOK_LOOKUP_API_URL=https://lookup.ghlab.info/api/v1/tiktok
# One server-only key for all social lookup integrations. Keep this value raw:
# a slash in the provider key is `/`, not `%2F`.
LOOKUP_API_KEY=replace-with-provider-key
# Optional development-only demo wallet top-up. Keep false/unset in production.
NEXT_PUBLIC_ENABLE_DEMO_TOPUP=false
# Server-only admin network gate. Empty = disabled.
# Example: ADMIN_ALLOWED_IPS=203.0.113.10,2001:db8::10
ADMIN_ALLOWED_IPS=
# Header your edge proxy overwrites with the real client IP. Never accept a
# client-supplied value unchanged. Cloudflare: cf-connecting-ip; nginx: x-real-ip.
ADMIN_CLIENT_IP_HEADER=x-forwarded-for
# Development only: set these when this machine needs an outbound HTTP proxy.
# Do not set them in production.
# NODE_USE_ENV_PROXY=1
# HTTP_PROXY=http://proxy.internal:8080
# HTTPS_PROXY=http://proxy.internal:8080
