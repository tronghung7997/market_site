BFF_REQUEST_SIGNING_KEY_ID=market-bff-v1


# --- PayOS -------------------------------------------------------------------
# Copy 3 khoá từ marketplace-svc/.env trên máy dev (bộ kênh thật đang test),
# hoặc tạo kênh RIÊNG cho prod trên https://my.payos.vn để tách sao kê.
# Sau khi backend chạy: vào my.payos.vn đăng ký + CONFIRM webhook:
# https://api-market.taskforces.info/webhooks/payos
#PAYOS_BASE_URL=https://api-merchant.payos.vn
#PAYOS_CLIENT_ID=3b2f92e3-ead7-43f9-8acd-bb44fe762010
#PAYOS_API_KEY=4ecfadfe-6948-4b8e-9a66-12b3db223478
#PAYOS_CHECKSUM_KEY=3d8a5a89f0006a18160dafad8caa59f6cd46d8ad3183edee78f674a464900a99

# --- Nạp tiền (đều = mặc định code, ghi tường minh cho dễ chỉnh) --------------
DEPOSIT_MIN_AMOUNT=10000
DEPOSIT_MAX_AMOUNT=100000000
DEPOSIT_MAX_PENDING_PER_ACCOUNT=3
DEPOSIT_EXPIRE_MINUTES=30
DEPOSIT_RECONCILE_RETENTION_HOURS=48
# TUYỆT ĐỐI false ở prod — đây là nút nạp tiền giả cho dev/demo.
ENABLE_DEMO_TOPUP=false

# --- TopProxy ----------------------------------------------------------------
# Khác dev ("od") vì hai môi trường dùng chung API key TopProxy — marker tra
# trên toàn tài khoản, trùng prefix là đơn dev "nhận nhầm" proxy của prod.
TOPPROXY_MARKER_PREFIX=pd
LEGACY_SELLER_API_KEY_MODE=deny
NOWPAYMENTS_ENABLED=true
