# Copy to .env.mock-dproxy (gitignored) and replace every secret before exposing
# the service through Cloudflare Tunnel.
MOCK_DPROXY_API_KEY=replace-with-a-long-random-api-key
MOCK_DPROXY_CONTROL_KEY=replace-with-a-different-long-random-control-key
MOCK_DPROXY_DASHBOARD_USER=admin
MOCK_DPROXY_DASHBOARD_PASSWORD=replace-with-a-long-random-dashboard-password
MOCK_DPROXY_AUTH_TYPE=bearer
MOCK_DPROXY_COOLDOWN_SECONDS=2
