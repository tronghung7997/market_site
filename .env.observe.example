# Copy to .env.observe on the server (never commit the real file).
# Read by both marketplace-svc (OTEL_*) and vector (O2_*).
NO_PROXY=content-observe.dmz-gate.com

# Backend traces + metrics
OTEL_EXPORTER_OTLP_ENDPOINT=https://content-observe.dmz-gate.com/api/default
# Authorization=Basic%20<base64(email:token), "=" written as %3D>,stream-name=market_site
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_SAMPLER_ARG=0.1

# Vector → logs
O2_ENDPOINT=https://content-observe.dmz-gate.com
O2_ORG=default
O2_STREAM=market_site
O2_USER=
O2_PASSWORD=

